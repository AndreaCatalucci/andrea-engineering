#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
MODE="sync"

if [[ "${1:-}" == "--check" ]]; then
  MODE="check"
elif [[ $# -gt 0 ]]; then
  echo "usage: scripts/sync-shared-skill-assets [--check]" >&2
  exit 2
fi

drift=0

mirror() {
  local source="$ROOT_DIR/$1"
  local destination="$ROOT_DIR/$2"

  if [[ "$MODE" == "check" ]]; then
    if [[ ! -f "$destination" ]] || ! cmp -s "$source" "$destination"; then
      echo "out of sync: $2 (source: $1)" >&2
      drift=1
    fi
    return
  fi

  mkdir -p "$(dirname "$destination")"
  cp "$source" "$destination"
}

interaction_consumers=(
  ae-babysit-pr ae-brainstorm ae-commit-push-pr ae-commit
  ae-compound-refresh ae-debug ae-dogfood ae-explain ae-ideate
  ae-optimize ae-plan ae-pov ae-product-pulse ae-promote ae-resolve-pr-feedback
  ae-setup ae-strategy ae-sweep ae-test-browser ae-test-xcode ae-work ae-worktree
)

for skill in "${interaction_consumers[@]}"; do
  mirror shared/codex-interaction.md "skills/$skill/references/codex-interaction.md"
done

plain_language_consumers=(
  ae-brainstorm ae-code-review ae-commit-push-pr ae-compound
  ae-compound-refresh ae-doc-review ae-explain ae-ideate ae-plan ae-pov
  ae-product-pulse ae-promote ae-riffrec-feedback-analysis ae-strategy ae-sweep
)

for skill in "${plain_language_consumers[@]}"; do
  mirror shared/plain-language.md "skills/$skill/references/plain-language.md"
done

profile_consumers=(
  ae-brainstorm ae-code-review ae-compound ae-debug
  ae-explain ae-ideate ae-optimize ae-pov
)

for skill in "${profile_consumers[@]}"; do
  mirror skills/ae-plan/scripts/repo-profile-cache.py "skills/$skill/scripts/repo-profile-cache.py"
  mirror skills/ae-plan/references/repo-profile-cache.md "skills/$skill/references/repo-profile-cache.md"
  mirror skills/ae-plan/references/agents/repo-profiler.md "skills/$skill/references/agents/repo-profiler.md"
done

mirror skills/ae-compound/references/concepts-vocabulary.md skills/ae-compound-refresh/references/concepts-vocabulary.md
mirror skills/ae-compound/references/schema.yaml skills/ae-compound-refresh/references/schema.yaml
mirror skills/ae-compound/references/yaml-schema.md skills/ae-compound-refresh/references/yaml-schema.md
mirror skills/ae-compound/assets/resolution-template.md skills/ae-compound-refresh/assets/resolution-template.md
mirror skills/ae-compound/scripts/validate-frontmatter.py skills/ae-compound-refresh/scripts/validate-frontmatter.py
mirror skills/ae-compound/scripts/validate-doc-claims.py skills/ae-compound-refresh/scripts/validate-doc-claims.py

mirror skills/ae-riffrec-feedback-analysis/scripts/analyze_riffrec_zip.py skills/ae-sweep/scripts/analyze_riffrec_zip.py
mirror skills/ae-brainstorm/references/markdown-rendering.md skills/ae-ideate/references/markdown-rendering.md

if [[ "$MODE" == "check" && "$drift" -ne 0 ]]; then
  exit 1
fi
