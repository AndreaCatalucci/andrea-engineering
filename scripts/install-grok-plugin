#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
GROK_CLI="${GROK_PLUGIN_CLI:-grok}"
DRY_RUN=0

usage() {
  cat <<'EOF'
usage: scripts/install-grok-plugin [--dry-run]

Install or refresh this checkout for Grok Build sessions for the current user.

options:
  --dry-run  Show install commands without changing marketplaces or plugins.
  -h, --help Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v "$GROK_CLI" >/dev/null 2>&1; then
  echo "Grok Build CLI not found: $GROK_CLI" >&2
  echo "Install or update Grok Build, then run this script again." >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required to read the plugin metadata." >&2
  exit 1
fi

PLUGIN_NAME="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["name"])' "$ROOT_DIR/.grok-plugin/plugin.json")"
MARKETPLACE_NAME="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["name"])' "$ROOT_DIR/.grok-plugin/marketplace.json")"

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

run() {
  print_command "$@"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    "$@"
  fi
}

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "Grok Build inspection commands:"
  print_command "$GROK_CLI" plugin list --json
  print_command "$GROK_CLI" plugin marketplace list --json
  echo "If no marketplace already exposes this checkout:"
  print_command "$GROK_CLI" plugin marketplace add "$ROOT_DIR"
  echo "Install or refresh from this checkout:"
  print_command "$GROK_CLI" plugin install "$ROOT_DIR" --trust
  echo "Dry run complete; Grok Build was not launched or changed."
  exit 0
fi

marketplace_list="$("$GROK_CLI" plugin marketplace list --json)"
configured_root="$(printf '%s' "$marketplace_list" | python3 -c '
import json, os, sys

root = os.path.realpath(sys.argv[1])
name = sys.argv[2]
payload = json.load(sys.stdin)
marketplaces = payload if isinstance(payload, list) else payload.get("marketplaces", [])
for marketplace in marketplaces:
    if marketplace.get("name") != name:
        continue
    candidates = [
        marketplace.get("path"),
        marketplace.get("root"),
    ]
    source = marketplace.get("source")
    if isinstance(source, dict):
        candidates.append(source.get("path"))
        url = source.get("url")
        if url and not str(url).startswith(("http://", "https://", "git@")):
            candidates.append(url)
    elif isinstance(source, str) and not source.startswith(("http://", "https://", "git@")):
        candidates.append(source)
    for candidate in candidates:
        if candidate:
            print(os.path.realpath(candidate))
            raise SystemExit(0)
    print("UNRESOLVED")
    raise SystemExit(0)
' "$ROOT_DIR" "$MARKETPLACE_NAME")"

if [[ "$configured_root" == "UNRESOLVED" ]]; then
  echo "Marketplace '$MARKETPLACE_NAME' is registered, but its local path could not be verified." >&2
  echo "Remove it with: $GROK_CLI plugin marketplace remove $MARKETPLACE_NAME" >&2
  exit 1
fi

if [[ -n "$configured_root" && "$configured_root" != "$ROOT_DIR" ]]; then
  echo "Marketplace '$MARKETPLACE_NAME' already points at: $configured_root" >&2
  echo "Refusing to replace it with: $ROOT_DIR" >&2
  exit 1
fi

if [[ -z "$configured_root" ]]; then
  echo "Registering this checkout as the '$MARKETPLACE_NAME' marketplace:"
  run "$GROK_CLI" plugin marketplace add "$ROOT_DIR"
fi

echo "Installing or refreshing $PLUGIN_NAME from this checkout:"
run "$GROK_CLI" plugin install "$ROOT_DIR" --trust

plugin_list="$("$GROK_CLI" plugin list --json)"
if ! printf '%s' "$plugin_list" | python3 -c '
import json, os, sys

name = sys.argv[1]
root = os.path.realpath(sys.argv[2])
payload = json.load(sys.stdin)
plugins = payload if isinstance(payload, list) else payload.get("installed", payload.get("plugins", []))
for plugin in plugins:
    plugin_name = plugin.get("name") or plugin.get("id") or ""
    if plugin_name.split("/")[-1].split("@")[0] != name and plugin_name != name:
        continue
    if plugin.get("enabled") is False:
        raise SystemExit(1)
    raise SystemExit(0)
raise SystemExit(1)
' "$PLUGIN_NAME" "$ROOT_DIR"; then
  echo "Grok Build did not report $PLUGIN_NAME as installed and enabled." >&2
  exit 1
fi

echo "Installed and enabled for new Grok Build sessions."
echo "Reload plugins in the Plugins tab, or start a new session, to load the refreshed skills."
