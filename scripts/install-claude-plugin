#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
CLAUDE_CLI="${CLAUDE_PLUGIN_CLI:-claude}"
DRY_RUN=0

usage() {
  cat <<'EOF'
usage: scripts/install-claude-plugin [--dry-run]

Install or refresh this checkout for Claude Code sessions for the current user.

options:
  --dry-run  Show install commands without changing marketplaces or plugins.
  -h, --help Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v "$CLAUDE_CLI" >/dev/null 2>&1; then
  echo "Claude Code CLI not found: $CLAUDE_CLI" >&2
  echo "Install or update Claude Code, then run this script again." >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required to read the plugin metadata." >&2
  exit 1
fi

if ! "$ROOT_DIR/scripts/sync-shared-skill-assets" --check; then
  echo "Shared skill files are out of sync; run scripts/sync-shared-skill-assets first." >&2
  exit 1
fi

PLUGIN_NAME="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["name"])' "$ROOT_DIR/.claude-plugin/plugin.json")"
MARKETPLACE_NAME="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["name"])' "$ROOT_DIR/.claude-plugin/marketplace.json")"
SELECTOR="$PLUGIN_NAME@$MARKETPLACE_NAME"

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

run() {
  print_command "$@"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    "$@"
  fi
}

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "Claude Code inspection commands:"
  print_command "$CLAUDE_CLI" plugin list --json
  print_command "$CLAUDE_CLI" plugin marketplace list --json
  echo "If no marketplace already exposes this checkout:"
  print_command "$CLAUDE_CLI" plugin marketplace add "$ROOT_DIR"
  echo "Using the marketplace found or added above:"
  print_command "$CLAUDE_CLI" plugin install "$SELECTOR" --scope user
  echo "Dry run complete; Claude Code was not launched or changed."
  exit 0
fi

marketplace_list="$("$CLAUDE_CLI" plugin marketplace list --json)"
configured_root="$(printf '%s' "$marketplace_list" | python3 -c '
import json, os, sys

root = os.path.realpath(sys.argv[1])
name = sys.argv[2]
payload = json.load(sys.stdin)
marketplaces = payload if isinstance(payload, list) else payload.get("marketplaces", [])
for marketplace in marketplaces:
    if marketplace.get("name") != name:
        continue
    candidates = [
        marketplace.get("path"),
        marketplace.get("root"),
    ]
    source = marketplace.get("source")
    if isinstance(source, dict):
        candidates.append(source.get("path"))
        url = source.get("url")
        if url and not str(url).startswith(("http://", "https://", "git@")):
            candidates.append(url)
    elif isinstance(source, str) and source not in {"github", "git", "url", "local", "directory"}:
        candidates.append(source)
    for candidate in candidates:
        if candidate:
            print(os.path.realpath(candidate))
            raise SystemExit(0)
    print("UNRESOLVED")
    raise SystemExit(0)
' "$ROOT_DIR" "$MARKETPLACE_NAME")"

if [[ "$configured_root" == "UNRESOLVED" ]]; then
  echo "Marketplace '$MARKETPLACE_NAME' is registered, but its local path could not be verified." >&2
  echo "Remove it with: $CLAUDE_CLI plugin marketplace remove $MARKETPLACE_NAME" >&2
  exit 1
fi

if [[ -n "$configured_root" && "$configured_root" != "$ROOT_DIR" ]]; then
  echo "Marketplace '$MARKETPLACE_NAME' already points at: $configured_root" >&2
  echo "Refusing to replace it with: $ROOT_DIR" >&2
  exit 1
fi

if [[ -z "$configured_root" ]]; then
  echo "Registering this checkout as the '$MARKETPLACE_NAME' marketplace:"
  run "$CLAUDE_CLI" plugin marketplace add "$ROOT_DIR"
fi

echo "Installing or refreshing $SELECTOR:"
run "$CLAUDE_CLI" plugin install "$SELECTOR" --scope user

plugin_list="$("$CLAUDE_CLI" plugin list --json)"
if ! printf '%s' "$plugin_list" | python3 -c '
import json, sys

selector = sys.argv[1]
payload = json.load(sys.stdin)
plugins = payload if isinstance(payload, list) else payload.get("installed", payload.get("plugins", []))
if not any(
    plugin.get("id") == selector
    or plugin.get("pluginId") == selector
    or plugin.get("name") == selector.split("@", 1)[0]
    for plugin in plugins
):
    raise SystemExit(1)
if any(
    (plugin.get("id") == selector or plugin.get("pluginId") == selector)
    and plugin.get("enabled") is False
    for plugin in plugins
):
    raise SystemExit(1)
' "$SELECTOR"; then
  echo "Claude Code did not report $SELECTOR as installed and enabled." >&2
  exit 1
fi

echo "Installed and enabled for new Claude Code sessions."
echo "Start a new Claude Code session, or run /reload-plugins, to load the refreshed skills."
