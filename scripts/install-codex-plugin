#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
CODEX_CLI="${CODEX_PLUGIN_CLI:-codex}"
DRY_RUN=0

usage() {
  cat <<'EOF'
usage: scripts/install-codex-plugin [--dry-run]

Install or refresh this checkout for all new Codex Desktop and CLI sessions
for the current user.

options:
  --dry-run  Show install commands without changing marketplaces or plugins.
  -h, --help Show this help.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)
      DRY_RUN=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if ! command -v "$CODEX_CLI" >/dev/null 2>&1; then
  echo "Codex CLI not found: $CODEX_CLI" >&2
  echo "Install or update Codex CLI, then run this script again." >&2
  exit 1
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 is required to read the plugin metadata." >&2
  exit 1
fi

PLUGIN_NAME="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["name"])' "$ROOT_DIR/.codex-plugin/plugin.json")"
MARKETPLACE_NAME="$(python3 -c 'import json, sys; print(json.load(open(sys.argv[1]))["name"])' "$ROOT_DIR/.agents/plugins/marketplace.json")"

print_command() {
  printf '  '
  printf '%q ' "$@"
  printf '\n'
}

run() {
  print_command "$@"
  if [[ "$DRY_RUN" -eq 0 ]]; then
    "$@"
  fi
}

if [[ "$DRY_RUN" -eq 1 ]]; then
  echo "Codex inspection commands:"
  print_command "$CODEX_CLI" plugin list --available --json
  print_command "$CODEX_CLI" plugin marketplace list --json
  echo "If no marketplace already exposes this checkout:"
  print_command "$CODEX_CLI" plugin marketplace add "$ROOT_DIR" --json
  echo "Using the marketplace found or added above:"
  print_command "$CODEX_CLI" plugin add "$PLUGIN_NAME@<marketplace>" --json
  echo "Dry run complete; Codex was not launched or changed."
  exit 0
fi

plugin_list="$("$CODEX_CLI" plugin list --available --json)"
selector="$(printf '%s' "$plugin_list" | python3 -c '
import json, os, sys

root = os.path.realpath(sys.argv[1])
plugins = json.load(sys.stdin)
for plugin in plugins.get("installed", []) + plugins.get("available", []):
    source = plugin.get("source", {})
    path = source.get("path") if source.get("source") == "local" else None
    if plugin.get("name") == sys.argv[2] and path and os.path.realpath(path) == root:
        print(plugin["pluginId"])
        break
' "$ROOT_DIR" "$PLUGIN_NAME")"

if [[ -z "$selector" ]]; then
  marketplace_list="$("$CODEX_CLI" plugin marketplace list --json)"
  configured_root="$(printf '%s' "$marketplace_list" | python3 -c '
import json, os, sys

for marketplace in json.load(sys.stdin).get("marketplaces", []):
    if marketplace.get("name") == sys.argv[1]:
        print(os.path.realpath(marketplace["root"]))
        break
' "$MARKETPLACE_NAME")"

  if [[ -n "$configured_root" && "$configured_root" != "$ROOT_DIR" ]]; then
    echo "Marketplace '$MARKETPLACE_NAME' already points at: $configured_root" >&2
    echo "Refusing to replace it with: $ROOT_DIR" >&2
    exit 1
  fi

  if [[ -z "$configured_root" ]]; then
    echo "Registering this checkout as the '$MARKETPLACE_NAME' marketplace:"
    run "$CODEX_CLI" plugin marketplace add "$ROOT_DIR" --json
  fi

  selector="$PLUGIN_NAME@$MARKETPLACE_NAME"
fi

echo "Installing or refreshing $selector:"
run "$CODEX_CLI" plugin add "$selector" --json

plugin_list="$("$CODEX_CLI" plugin list --json)"
if ! printf '%s' "$plugin_list" | python3 -c '
import json, sys

selector = sys.argv[1]
installed = json.load(sys.stdin).get("installed", [])
if not any(
    plugin.get("pluginId") == selector
    and plugin.get("installed") is True
    and plugin.get("enabled") is True
    for plugin in installed
):
    raise SystemExit(1)
' "$selector"; then
  echo "Codex did not report $selector as installed and enabled." >&2
  exit 1
fi

echo "Installed and enabled for new Codex Desktop tasks and CLI sessions."
echo "Restart Codex Desktop or start a new CLI session to load the refreshed skills."
